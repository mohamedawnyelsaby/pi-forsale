# Copy to .env.local (never commit real values; this repo is public)

# Postgres connection string (Supabase / Neon)
DATABASE_URL=

# Random 32+ char secret used to sign session cookies
SESSION_SECRET=

# Pi Network: server API key from the Pi Developer Portal (server-side only)
PI_API_KEY=
# "true" while testing in Pi sandbox, "false" in production
NEXT_PUBLIC_PI_SANDBOX=true

# Platform commission in basis points (250 = 2.5% of the deal value)
COMMISSION_BPS=250
# Share of the commission paid to the broker when a broker is involved (4000 = 40%)
BROKER_SHARE_BPS=4000
